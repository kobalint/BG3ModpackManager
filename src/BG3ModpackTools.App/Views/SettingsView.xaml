<UserControl x:Class="BG3ModpackTools.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BG3ModpackTools.App.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" MaxWidth="920">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{helpers:Loc Settings.Title}" />
                <TextBlock Style="{StaticResource MutedCaption}" Text="{helpers:Loc Settings.Subtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Appearance & Language Card -->
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Settings.Card.Appearance}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{helpers:Loc Settings.ThemeLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <RadioButton x:Name="DarkThemeRadio"
                                         Content="{helpers:Loc Settings.Theme.Dark}"
                                         GroupName="UiTheme"
                                         Checked="OnThemeRadioChecked"
                                         Margin="0,2,22,2" />
                            <RadioButton x:Name="LightThemeRadio"
                                         Content="{helpers:Loc Settings.Theme.Light}"
                                         GroupName="UiTheme"
                                         Checked="OnThemeRadioChecked"
                                         Margin="0,2,0,2" />
                        </WrapPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{helpers:Loc Settings.LanguageLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox x:Name="LanguageCombo"
                                  Grid.Column="1"
                                  MinWidth="180"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectionChanged="OnLanguageSelectionChanged" />
                    </Grid>

                    <WrapPanel Margin="0,2,0,4">
                        <Button Content="{helpers:Loc Settings.Btn.ReloadLanguages}" Click="OnReloadLanguagesClick" Margin="0,0,6,6" />
                        <Button Content="{helpers:Loc Settings.Btn.ExportTemplate}" Click="OnExportLanguageTemplateClick" Margin="0,0,6,6" />
                        <Button Content="{helpers:Loc Settings.Btn.OpenLanguages}" Click="OnOpenLanguagesFolderClick" Margin="0,0,0,6" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource MutedCaption}" Text="{helpers:Loc Settings.LanguageHint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Paths Card -->
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Settings.Btn.AutoDetect}" Click="OnAutoDetectClick" Margin="8,0,0,0" />
                        <TextBlock Text="{helpers:Loc Settings.Card.Paths}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>

                    <!-- BG3 Mods Folder -->
                    <TextBlock Text="{helpers:Loc Settings.ModsFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Open}" MinWidth="76" Padding="10,5" Margin="6,0,0,0" Click="OnOpenModsClick" />
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Browse}" MinWidth="92" Padding="10,5" Margin="6,0,0,0" Click="OnBrowseModsClick" />
                        <TextBlock x:Name="ModsStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Width="74" TextAlignment="Center" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBox x:Name="ModsFolderBox" TextChanged="OnPathTextChanged" />
                    </DockPanel>

                    <!-- BG3 Game Folder -->
                    <TextBlock Text="{helpers:Loc Settings.GameFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Open}" MinWidth="76" Padding="10,5" Margin="6,0,0,0" Click="OnOpenGameClick" />
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Browse}" MinWidth="92" Padding="10,5" Margin="6,0,0,0" Click="OnBrowseGameClick" />
                        <TextBlock x:Name="GameStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Width="74" TextAlignment="Center" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBox x:Name="GameFolderBox" TextChanged="OnGameFolderTextChanged" />
                    </DockPanel>

                    <!-- BG3 Data Folder -->
                    <TextBlock Text="{helpers:Loc Settings.DataFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Open}" MinWidth="76" Padding="10,5" Margin="6,0,0,0" Click="OnOpenDataClick" />
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Browse}" MinWidth="92" Padding="10,5" Margin="6,0,0,0" Click="OnBrowseDataClick" />
                        <TextBlock x:Name="DataStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Width="74" TextAlignment="Center" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBox x:Name="DataFolderBox" TextChanged="OnPathTextChanged" />
                    </DockPanel>

                    <!-- BG3ModManager Orders Folder -->
                    <TextBlock Text="{helpers:Loc Settings.OrdersFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Open}" MinWidth="76" Padding="10,5" Margin="6,0,0,0" Click="OnOpenOrdersClick" />
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Browse}" MinWidth="92" Padding="10,5" Margin="6,0,0,0" Click="OnBrowseOrdersClick" />
                        <TextBlock x:Name="OrdersStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Width="74" TextAlignment="Center" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBox x:Name="OrdersFolderBox" TextChanged="OnPathTextChanged" />
                    </DockPanel>

                    <!-- Vault Folder -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{helpers:Loc Settings.VaultFolderLabel}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" />
                        <TextBlock x:Name="VaultVolumeHint" Grid.Column="1" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Right" />
                    </Grid>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Open}" MinWidth="76" Padding="10,5" Margin="6,0,0,0" Click="OnOpenVaultClick" />
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Browse}" MinWidth="92" Padding="10,5" Margin="6,0,0,0" Click="OnBrowseVaultClick" />
                        <TextBlock x:Name="VaultStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Width="74" TextAlignment="Center" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBox x:Name="VaultFolderBox" TextChanged="OnPathTextChanged" />
                    </DockPanel>

                    <!-- modsettings.lsx -->
                    <TextBlock Text="{helpers:Loc Settings.LsxPathLabel}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.BrowseFile}" MinWidth="106" Padding="10,5" Margin="6,0,0,0" Click="OnBrowseLsxClick" />
                        <TextBlock x:Name="LsxStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Width="74" TextAlignment="Center" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBox x:Name="LsxPathBox" TextChanged="OnPathTextChanged" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Game Launch Card -->
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Settings.Card.Launch}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{helpers:Loc Settings.LaunchRendererLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <RadioButton x:Name="LaunchDx11Radio"
                                         Content="{helpers:Loc Settings.Launch.DirectX11}"
                                         GroupName="Bg3LaunchRenderer"
                                         Checked="OnLaunchRendererRadioChecked"
                                         Margin="0,2,22,2" />
                            <RadioButton x:Name="LaunchVulkanRadio"
                                         Content="{helpers:Loc Settings.Launch.Vulkan}"
                                         GroupName="Bg3LaunchRenderer"
                                         Checked="OnLaunchRendererRadioChecked"
                                         Margin="0,2,0,2" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock x:Name="LaunchExeStatusText" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Behavior Card -->
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Settings.Card.Behavior}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <RadioButton x:Name="FullProfileModeRadio" GroupName="SwitchBehavior" Margin="0,0,0,8">
                        <TextBlock Text="{helpers:Loc Settings.Mode.FullProfile}" TextWrapping="Wrap" />
                    </RadioButton>
                    <RadioButton x:Name="OverridesOnlyModeRadio" GroupName="SwitchBehavior" Margin="0,0,0,14">
                        <TextBlock Text="{helpers:Loc Settings.Mode.OverridesOnly}" TextWrapping="Wrap" />
                    </RadioButton>

                    <CheckBox x:Name="SyncLsxCheckBox">
                        <TextBlock Text="{helpers:Loc Settings.SyncLsxCheck}" TextWrapping="Wrap" />
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Save Footer -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.SaveSettings}" Style="{StaticResource AccentButton}" MinWidth="150" Padding="14,6" Margin="8,0,0,6" Click="OnSaveClick" />
                <Button DockPanel.Dock="Left" HorizontalAlignment="Left" Content="{helpers:Loc Settings.Btn.OpenDataFolder}" Margin="0,0,0,6" Click="OnOpenAppDataClick" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
