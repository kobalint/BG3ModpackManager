<Window x:Class="BG3ModpackTools.App.Views.Dialogs.BulkImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:BG3ModpackTools.App.Helpers"
        Title="{helpers:Loc Dialog.BulkImport.Title}"
        Style="{StaticResource AppWindowStyle}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{helpers:Loc Dialog.BulkImport.Heading}" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource MutedCaption}"
                       TextWrapping="Wrap"
                       Text="{helpers:Loc Dialog.BulkImport.Subtitle}"
                       Margin="0,0,0,14" />

            <TextBlock Text="{helpers:Loc Dialog.BulkImport.SourceLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Browse}" Width="106" Margin="8,0,0,0" Click="OnBrowseClick" />
                <TextBox x:Name="FolderBox" TextChanged="OnFolderChanged" />
            </DockPanel>

            <TextBlock x:Name="PreviewText" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,0,0,12" Text="{helpers:Loc Dialog.BulkImport.PreviewPlaceholder}" />

            <StackPanel Margin="0,0,0,16">
                <RadioButton x:Name="CopyRadio" IsChecked="True" Margin="0,0,0,6">
                    <TextBlock Text="{helpers:Loc Dialog.BulkImport.CopyRadio}" TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton x:Name="MoveRadio">
                    <TextBlock Text="{helpers:Loc Dialog.BulkImport.MoveRadio}" TextWrapping="Wrap" />
                </RadioButton>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{helpers:Loc Common.Cancel}" MinWidth="90" Padding="14,6" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="ImportButton" Content="{helpers:Loc Dialog.BulkImport.BtnImport}" MinWidth="155" Padding="14,6" Style="{StaticResource AccentButton}" IsEnabled="False" IsDefault="True" Click="OnImportClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
