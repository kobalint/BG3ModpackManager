<Window x:Class="BG3ModpackTools.App.Views.Dialogs.PakInspectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:BG3ModpackTools.App.Helpers"
        Title="{helpers:Loc Dialog.Inspector.Title}"
        Style="{StaticResource AppWindowStyle}"
        Width="780"
        Height="580"
        MinWidth="520"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock x:Name="FileText" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock x:Name="UuidText" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock x:Name="MetaText" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="OverrideBadgeText" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="OverrideReasonsText" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock x:Name="HashText" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="FileCountLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource MutedCaption}" />
            <TextBox x:Name="FilterBox" TextChanged="OnFilterChanged" ToolTip="{helpers:Loc Dialog.Inspector.FilterTooltip}" />
        </DockPanel>

        <ListBox x:Name="FilesListBox" Grid.Row="2" FontFamily="Consolas" FontSize="12" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{helpers:Loc Common.Close}" Width="105" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
