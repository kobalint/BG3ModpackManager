<UserControl x:Class="BG3ModpackManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BG3ModpackManager.App.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="920">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{helpers:Loc Settings.Title}" />
                <TextBlock Style="{StaticResource MutedCaption}" Text="{helpers:Loc Settings.Subtitle}" />
            </StackPanel>

            <!-- Appearance & Language Card -->
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Settings.Card.Appearance}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="{helpers:Loc Settings.ThemeLabel}" FontWeight="SemiBold" Width="155" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="DarkThemeRadio"
                                         Content="{helpers:Loc Settings.Theme.Dark}"
                                         GroupName="UiTheme"
                                         Checked="OnThemeRadioChecked"
                                         Margin="0,0,22,0" />
                            <RadioButton x:Name="LightThemeRadio"
                                         Content="{helpers:Loc Settings.Theme.Light}"
                                         GroupName="UiTheme"
                                         Checked="OnThemeRadioChecked" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="{helpers:Loc Settings.LanguageLabel}" FontWeight="SemiBold" Width="155" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{helpers:Loc Settings.Btn.ReloadLanguages}" Click="OnReloadLanguagesClick" Margin="8,0,6,0" />
                            <Button Content="{helpers:Loc Settings.Btn.ExportTemplate}" Click="OnExportLanguageTemplateClick" Margin="0,0,6,0" />
                            <Button Content="{helpers:Loc Settings.Btn.OpenLanguages}" Click="OnOpenLanguagesFolderClick" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageCombo"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectionChanged="OnLanguageSelectionChanged" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource MutedCaption}" Text="{helpers:Loc Settings.LanguageHint}" TextWrapping="Wrap" Margin="155,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Paths Card -->
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Settings.Btn.AutoDetect}" Click="OnAutoDetectClick" />
                        <TextBlock Text="{helpers:Loc Settings.Card.Paths}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- BG3 Mods Folder -->
                    <TextBlock Text="{helpers:Loc Settings.ModsFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Open}" Width="92" Margin="6,0,0,0" Click="OnOpenModsClick" />
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Browse}" Width="106" Margin="6,0,0,0" Click="OnBrowseModsClick" />
                        <TextBlock x:Name="ModsStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Width="78" TextAlignment="Center" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBox x:Name="ModsFolderBox" TextChanged="OnPathTextChanged" />
                    </DockPanel>

                    <!-- BG3 Game Folder -->
                    <TextBlock Text="{helpers:Loc Settings.GameFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Open}" Width="92" Margin="6,0,0,0" Click="OnOpenGameClick" />
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Browse}" Width="106" Margin="6,0,0,0" Click="OnBrowseGameClick" />
                        <TextBlock x:Name="GameStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Width="78" TextAlignment="Center" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBox x:Name="GameFolderBox" TextChanged="OnGameFolderTextChanged" />
                    </DockPanel>

                    <!-- BG3 Data Folder -->
                    <TextBlock Text="{helpers:Loc Settings.DataFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Open}" Width="92" Margin="6,0,0,0" Click="OnOpenDataClick" />
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Browse}" Width="106" Margin="6,0,0,0" Click="OnBrowseDataClick" />
                        <TextBlock x:Name="DataStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Width="78" TextAlignment="Center" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBox x:Name="DataFolderBox" TextChanged="OnPathTextChanged" />
                    </DockPanel>

                    <!-- BG3ModManager Orders Folder -->
                    <TextBlock Text="{helpers:Loc Settings.OrdersFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Open}" Width="92" Margin="6,0,0,0" Click="OnOpenOrdersClick" />
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Browse}" Width="106" Margin="6,0,0,0" Click="OnBrowseOrdersClick" />
                        <TextBlock x:Name="OrdersStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Width="78" TextAlignment="Center" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBox x:Name="OrdersFolderBox" TextChanged="OnPathTextChanged" />
                    </DockPanel>

                    <!-- Vault Folder -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="VaultVolumeHint" DockPanel.Dock="Right" FontSize="11.5" VerticalAlignment="Center" />
                        <TextBlock Text="{helpers:Loc Settings.VaultFolderLabel}" FontWeight="SemiBold" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Open}" Width="92" Margin="6,0,0,0" Click="OnOpenVaultClick" />
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.Browse}" Width="106" Margin="6,0,0,0" Click="OnBrowseVaultClick" />
                        <TextBlock x:Name="VaultStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Width="78" TextAlignment="Center" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBox x:Name="VaultFolderBox" TextChanged="OnPathTextChanged" />
                    </DockPanel>

                    <!-- modsettings.lsx -->
                    <TextBlock Text="{helpers:Loc Settings.LsxPathLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.BrowseFile}" Width="125" Margin="6,0,0,0" Click="OnBrowseLsxClick" />
                        <TextBlock x:Name="LsxStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Width="78" TextAlignment="Center" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBox x:Name="LsxPathBox" TextChanged="OnPathTextChanged" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Behavior Card -->
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Settings.Card.Behavior}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <RadioButton x:Name="FullProfileModeRadio"
                                 GroupName="SwitchBehavior"
                                 Content="{helpers:Loc Settings.Mode.FullProfile}"
                                 Margin="0,0,0,8" />
                    <RadioButton x:Name="OverridesOnlyModeRadio"
                                 GroupName="SwitchBehavior"
                                 Content="{helpers:Loc Settings.Mode.OverridesOnly}"
                                 Margin="0,0,0,14" />

                    <CheckBox x:Name="SyncLsxCheckBox"
                              Content="{helpers:Loc Settings.SyncLsxCheck}" />
                </StackPanel>
            </Border>

            <!-- Save Footer -->
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{helpers:Loc Settings.Btn.OpenDataFolder}" Click="OnOpenAppDataClick" />
                <Button DockPanel.Dock="Right" Content="{helpers:Loc Common.SaveSettings}" Style="{StaticResource AccentButton}" Width="175" Click="OnSaveClick" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
