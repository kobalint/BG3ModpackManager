<Window x:Class="BG3ModpackManager.App.Views.Dialogs.ArchiveImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:BG3ModpackManager.App.Helpers"
        Title="{helpers:Loc Dialog.ArchiveImport.Title}"
        Style="{StaticResource AppWindowStyle}"
        Width="880"
        Height="610"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="SourceTitleText" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="SourceSubtitleText" Style="{StaticResource MutedCaption}" Margin="0,3,0,0" />
        </StackPanel>

        <DataGrid x:Name="ItemsGrid" Grid.Row="1" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn helpers:LocHelper.HeaderKey="Dialog.ArchiveImport.Col.Import" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.ArchiveImport.Col.Item" Binding="{Binding DisplayName}" IsReadOnly="True" Width="1.5*" />
                <DataGridTemplateColumn helpers:LocHelper.HeaderKey="Dialog.ArchiveImport.Col.Dest" Width="165">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AvailableTargets}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Kind"
                                      SelectedValue="{Binding TargetKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="6,3" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.ArchiveImport.Col.Files" Binding="{Binding FileCount}" IsReadOnly="True" Width="60" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.ArchiveImport.Col.Size" Binding="{Binding SizeText}" IsReadOnly="True" Width="85" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.ArchiveImport.Col.Notes" Binding="{Binding StatusNotes}" IsReadOnly="True" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <CheckBox x:Name="HybridCheckBox"
                              Content="{helpers:Loc Dialog.ArchiveImport.HybridCheck}"
                              Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ActiveRadio" Content="{helpers:Loc Dialog.ArchiveImport.InstallActive}" IsChecked="True" Margin="0,0,18,0" />
                        <RadioButton x:Name="VaultRadio" Content="{helpers:Loc Dialog.ArchiveImport.StoreVault}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{helpers:Loc Dialog.ArchiveImport.LooseNameLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="CustomNameBox" Margin="0,0,0,8" />
                    <TextBlock Text="{helpers:Loc Dialog.ArchiveImport.ProfileLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="ProfileCombo" DisplayMemberPath="Label" SelectedValuePath="ProfileId" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource MutedCaption}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{helpers:Loc Common.Cancel}" Width="95" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="ImportButton" Content="{helpers:Loc Dialog.ArchiveImport.BtnImport}" Width="165" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnImportClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
