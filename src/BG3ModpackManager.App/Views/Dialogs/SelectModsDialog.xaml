<Window x:Class="BG3ModpackManager.App.Views.Dialogs.SelectModsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:BG3ModpackManager.App.Helpers"
        Title="{helpers:Loc Dialog.SelectMods.Title}"
        Style="{StaticResource AppWindowStyle}"
        Width="780"
        Height="560"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionTitle}" Text="{helpers:Loc Dialog.SelectMods.Heading}" />
            <TextBlock Style="{StaticResource MutedCaption}" Text="{helpers:Loc Dialog.SelectMods.Subtitle}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="{helpers:Loc Dialog.SelectMods.BtnSelectVisible}" Click="OnSelectVisibleClick" Margin="8,0,0,0" />
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" ToolTip="{helpers:Loc Dialog.SelectMods.SearchTooltip}" />
        </DockPanel>

        <DataGrid x:Name="ModsGrid" Grid.Row="2" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.SelectMods.Col.ModName" Binding="{Binding Name}" IsReadOnly="True" Width="2*" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.SelectMods.Col.Type" Binding="{Binding KindLabel}" IsReadOnly="True" Width="90" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.SelectMods.Col.Override" Binding="{Binding OverrideLabel}" IsReadOnly="True" Width="95" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.SelectMods.Col.Location" Binding="{Binding LocationLabel}" IsReadOnly="True" Width="85" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.SelectMods.Col.Files" Binding="{Binding FileSummary}" IsReadOnly="True" Width="1.6*" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.SelectMods.Col.Size" Binding="{Binding SizeText}" IsReadOnly="True" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CountLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource MutedCaption}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{helpers:Loc Common.Cancel}" Width="95" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="{helpers:Loc Dialog.SelectMods.BtnAdd}" Width="145" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnConfirmClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
