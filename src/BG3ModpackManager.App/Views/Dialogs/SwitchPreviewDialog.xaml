<Window x:Class="BG3ModpackManager.App.Views.Dialogs.SwitchPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:BG3ModpackManager.App.Helpers"
        Title="{helpers:Loc Dialog.SwitchPreview.Title}"
        Style="{StaticResource AppWindowStyle}"
        Width="860"
        Height="610"
        MinWidth="680"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeadingText" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="SubheadingText" Style="{StaticResource MutedCaption}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Summary KPI Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Dialog.SwitchPreview.KpiShared}" FontSize="11" Foreground="{DynamicResource BrushGreen}" FontWeight="SemiBold" />
                    <TextBlock x:Name="SharedCountText" FontSize="20" FontWeight="Bold" Margin="0,4,0,2" />
                    <TextBlock x:Name="SharedSavedText" Style="{StaticResource MutedCaption}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Dialog.SwitchPreview.KpiVault}" FontSize="11" Foreground="{DynamicResource BrushAmber}" FontWeight="SemiBold" />
                    <TextBlock x:Name="DeactivateCountText" FontSize="20" FontWeight="Bold" Margin="0,4,0,2" />
                    <TextBlock Text="{helpers:Loc Dialog.SwitchPreview.KpiVaultSub}" Style="{StaticResource MutedCaption}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Dialog.SwitchPreview.KpiActivate}" FontSize="11" Foreground="{DynamicResource BrushBlue}" FontWeight="SemiBold" />
                    <TextBlock x:Name="ActivateCountText" FontSize="20" FontWeight="Bold" Margin="0,4,0,2" />
                    <TextBlock Text="{helpers:Loc Dialog.SwitchPreview.KpiActivateSub}" Style="{StaticResource MutedCaption}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Dialog.SwitchPreview.KpiIssues}" FontSize="11" Foreground="{DynamicResource BrushCrimson}" FontWeight="SemiBold" />
                    <TextBlock x:Name="IssueCountText" FontSize="20" FontWeight="Bold" Margin="0,4,0,2" />
                    <TextBlock x:Name="IssueNoteText" Style="{StaticResource MutedCaption}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filter Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="FilterChanges" Content="{helpers:Loc Dialog.SwitchPreview.FilterChanges}" IsChecked="True" Checked="OnFilterChanged" Margin="0,0,16,0" />
            <RadioButton x:Name="FilterAll" Content="{helpers:Loc Dialog.SwitchPreview.FilterAll}" Checked="OnFilterChanged" />
        </StackPanel>

        <DataGrid x:Name="PlanGrid" Grid.Row="3" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn helpers:LocHelper.HeaderKey="Dialog.SwitchPreview.Col.Action" Width="165">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding ActionLabel}" Foreground="{Binding BadgeForeground}" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.SwitchPreview.Col.ModName" Binding="{Binding DisplayName}" Width="1.5*" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.SwitchPreview.Col.Payload" Binding="{Binding PayloadLabel}" Width="1.3*" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.SwitchPreview.Col.Size" Binding="{Binding SizeText}" Width="85" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Dialog.SwitchPreview.Col.Reason" Binding="{Binding Reason}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="ConflictBanner"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushCrimson}"
                       FontWeight="SemiBold"
                       Visibility="Collapsed"
                       Text="{helpers:Loc Dialog.SwitchPreview.ConflictBanner}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{helpers:Loc Common.Cancel}" Width="95" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton" Content="{helpers:Loc Dialog.SwitchPreview.BtnConfirm}" Width="175" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnConfirmClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
