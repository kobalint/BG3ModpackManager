<Window x:Class="BG3ModpackManager.App.Views.Dialogs.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:BG3ModpackManager.App.Helpers"
        Style="{StaticResource AppWindowStyle}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Padding="20">
        <StackPanel>
            <TextBlock x:Name="PromptHeading" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,0,0,6" />
            <TextBlock x:Name="PromptDescription" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBox x:Name="InputBox" Margin="0,0,0,12" />
            <CheckBox x:Name="OptionCheckBox" Visibility="Collapsed" Margin="0,0,0,8">
                <CheckBox.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </CheckBox.ContentTemplate>
            </CheckBox>
            <CheckBox x:Name="OptionCheckBox2" Visibility="Collapsed" Margin="0,0,0,12">
                <CheckBox.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </CheckBox.ContentTemplate>
            </CheckBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{helpers:Loc Common.Cancel}" MinWidth="90" Padding="14,6" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="{helpers:Loc Common.Confirm}" MinWidth="110" Padding="14,6" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
