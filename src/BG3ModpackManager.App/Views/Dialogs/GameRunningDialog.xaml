<Window x:Class="BG3ModpackManager.App.Views.Dialogs.GameRunningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:BG3ModpackManager.App.Helpers"
        Title="{helpers:Loc Dialog.GameRunning.Title}"
        Style="{StaticResource AppWindowStyle}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}"
                       Foreground="{DynamicResource BrushAmber}"
                       Text="{helpers:Loc Dialog.GameRunning.Heading}"
                       Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource MutedCaption}"
                       TextWrapping="Wrap"
                       Text="{helpers:Loc Dialog.GameRunning.Subtitle}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Dialog.GameRunning.ListLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl x:Name="ProcessList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource BrushCrimson}" FontFamily="Consolas" FontSize="12" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock x:Name="HintText"
                       Style="{StaticResource MutedCaption}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"
                       Text="{helpers:Loc Dialog.GameRunning.HintDefault}" />

            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{helpers:Loc Common.Cancel}" Width="95" IsCancel="True" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="GracefulCloseButton" Content="{helpers:Loc Dialog.GameRunning.BtnGraceful}" Click="OnGracefulCloseClick" Margin="0,0,8,0" />
                    <Button x:Name="RecheckButton" Content="{helpers:Loc Dialog.GameRunning.BtnRecheck}" Style="{StaticResource AccentButton}" Width="135" IsDefault="True" Click="OnRecheckClick" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
