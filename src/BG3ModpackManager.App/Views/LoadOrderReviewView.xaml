<UserControl x:Class="BG3ModpackManager.App.Views.LoadOrderReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BG3ModpackManager.App.Helpers"
             SizeChanged="OnViewSizeChanged">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & JSON Picker -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{helpers:Loc Review.Title}" />
                        <TextBlock Style="{StaticResource MutedCaption}" Text="{helpers:Loc Review.Subtitle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="LsxStatusPill"
                               Grid.Row="0"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Style="{StaticResource MutedCaption}" />
                </Grid>

                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{helpers:Loc Review.Btn.BrowseJson}" Click="OnBrowseJsonClick" Margin="8,0,6,0" />
                        <Button Content="{helpers:Loc Review.Btn.Rescan}" Style="{StaticResource AccentButton}" Click="OnRescanClick" />
                    </StackPanel>
                    <ComboBox x:Name="JsonFilesCombo"
                              MinWidth="180"
                              DisplayMemberPath="Display"
                              SelectionChanged="OnJsonComboChanged" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- Summary KPI Strip -->
        <UniformGrid x:Name="KpiStrip" Grid.Row="1" Columns="6" Margin="-3,0,-3,10">
            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="10">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Review.Kpi.InJson}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="KpiJsonTotal" Text="0" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="10">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Review.Kpi.Active}" FontSize="11" Foreground="{DynamicResource BrushGreen}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="KpiActive" Text="0" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="10">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Review.Kpi.ActiveOverrides}" FontSize="11" Foreground="{DynamicResource BrushAmber}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="KpiActiveOverrides" Text="0" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="10">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Review.Kpi.Bg3MmOverrides}" FontSize="11" Foreground="{DynamicResource BrushStandaloneOvr}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="KpiBg3MmOverrides" Text="0" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="10">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Review.Kpi.InVaultMissing}" FontSize="11" Foreground="{DynamicResource BrushBlue}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="KpiVaultMissing" Text="0 / 0" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="10">
                <StackPanel>
                    <TextBlock x:Name="KpiInactiveHeader" Text="{helpers:Loc Review.Kpi.InactiveBg3Mm}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="KpiUnlistedInactive" Text="0" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Search & Filter Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Row="0" Grid.Column="0" MinWidth="180" TextChanged="OnSearchChanged" ToolTip="{helpers:Loc Review.SearchTooltip}" />
            <WrapPanel x:Name="FilterPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <RadioButton x:Name="FilterAll" Content="{helpers:Loc Common.All}" IsChecked="True" Checked="OnFilterChanged" Margin="0,2,10,2" />
                <RadioButton x:Name="FilterOverrides" Content="{helpers:Loc Review.Filter.AllOverrides}" Checked="OnFilterChanged" Margin="0,2,10,2" />
                <RadioButton x:Name="FilterBg3MmOverrides" Content="{helpers:Loc Review.Filter.Bg3MmOverrides}" Checked="OnFilterChanged" Margin="0,2,10,2" />
                <RadioButton x:Name="FilterInactive" Content="{helpers:Loc Review.Filter.InactiveBg3Mm}" Checked="OnFilterChanged" Margin="0,2,10,2" />
                <RadioButton x:Name="FilterIssues" Content="{helpers:Loc Review.Filter.InVaultMissing}" Checked="OnFilterChanged" Margin="0,2,0,2" />
            </WrapPanel>
        </Grid>

        <!-- Audit Grid -->
        <DataGrid x:Name="AuditGrid"
                  Grid.Row="3"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionChanged="OnAuditGridSelectionChanged"
                  MouseDoubleClick="OnInspectSelectedClick">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{helpers:Loc Review.Menu.MoveSelectedToVault}" Click="OnMoveSelectedToVaultClick" />
                    <MenuItem Header="{helpers:Loc Review.Menu.RestoreSelected}" Click="OnRestoreSelectedFromVaultClick" />
                    <Separator />
                    <MenuItem Header="{helpers:Loc Review.Menu.InspectSelected}" Click="OnInspectSelectedClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding OrderText}" Width="42" />
                <DataGridTemplateColumn helpers:LocHelper.HeaderKey="Review.Col.Status" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusFg}" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Review.Col.Name" Binding="{Binding DisplayName}" Width="1.5*" MinWidth="145" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Review.Col.PakFile" Binding="{Binding PakFileName}" Width="1.3*" MinWidth="125" />
                <DataGridTemplateColumn helpers:LocHelper.HeaderKey="Review.Col.Override" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding OverrideBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding OverrideTooltip}">
                                <TextBlock Text="{Binding OverrideLabel}" Foreground="{Binding OverrideFg}" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Review.Col.Version" Binding="{Binding VersionText}" Width="78" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Review.Col.Size" Binding="{Binding SizeText}" Width="76" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Review.Col.Notes" Binding="{Binding Notes}" Width="1.5*" MinWidth="145" />
                <DataGridTemplateColumn helpers:LocHelper.HeaderKey="Review.Col.Vault" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding VaultActionLabel}"
                                    Visibility="{Binding VaultActionVisibility}"
                                    Click="OnRowVaultActionClick"
                                    Padding="8,2"
                                    FontSize="11.5" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Bar -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right"
                    VerticalAlignment="Top"
                    Margin="8,0,0,6"
                    Content="{helpers:Loc Review.Btn.InspectPak}"
                    Click="OnInspectSelectedClick" />
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="MoveSelectedToVaultButton"
                        Content="{helpers:Loc Review.Btn.MoveSelected}"
                        Click="OnMoveSelectedToVaultClick"
                        Margin="0,0,8,6"
                        IsEnabled="False" />
                <Button x:Name="RestoreSelectedButton"
                        Content="{helpers:Loc Review.Btn.RestoreSelected}"
                        Click="OnRestoreSelectedFromVaultClick"
                        Margin="0,0,8,6"
                        IsEnabled="False" />
                <Button x:Name="MoveUnlistedOverridesButton"
                        Content="{helpers:Loc Review.Btn.MoveUnlistedOverrides}"
                        Style="{StaticResource AccentButton}"
                        Click="OnMoveUnlistedOverridesClick"
                        Margin="0,0,8,6"
                        ToolTip="{helpers:Loc Review.Btn.MoveUnlistedOverridesTooltip}" />
                <Button x:Name="MoveAllUnlistedButton"
                        Content="{helpers:Loc Review.Btn.MoveAllInactive}"
                        Click="OnMoveAllUnlistedClick"
                        Margin="0,0,8,6"
                        ToolTip="{helpers:Loc Review.Btn.MoveAllInactiveTooltip}" />
                <Button x:Name="RestoreVaultJsonButton"
                        Content="{helpers:Loc Review.Btn.RestoreVaultJson}"
                        Click="OnRestoreVaultModsClick"
                        Margin="0,0,8,6" />
                <Button x:Name="CreateProfileFromJsonButton"
                        Content="{helpers:Loc Review.Btn.CreateProfile}"
                        Margin="0,0,0,6"
                        Click="OnCreateProfileClick" />
            </WrapPanel>
        </DockPanel>
    </Grid>
</UserControl>
