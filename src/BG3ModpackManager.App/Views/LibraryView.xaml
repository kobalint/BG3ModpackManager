<UserControl x:Class="BG3ModpackManager.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BG3ModpackManager.App.Helpers"
             SizeChanged="OnViewSizeChanged">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar & Title -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{helpers:Loc Library.Title}" />
                    <TextBlock Style="{StaticResource MutedCaption}" Text="{helpers:Loc Library.Subtitle}" TextWrapping="Wrap" />
                </StackPanel>

                <WrapPanel x:Name="ToolbarButtonsPanel" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{helpers:Loc Library.Btn.ImportArchive}" Style="{StaticResource AccentButton}" Click="OnImportArchiveClick" Margin="0,0,8,6" />
                    <Button Content="{helpers:Loc Library.Btn.ScanActive}" Click="OnScanActiveClick" Margin="0,0,8,6" />
                    <Button Content="{helpers:Loc Library.Btn.BulkImport}" Click="OnBulkImportClick" Margin="0,0,8,6" ToolTip="{helpers:Loc Library.Btn.BulkImportTooltip}" />
                    <Button Content="{helpers:Loc Library.Btn.RegisterLoose}" Click="OnRegisterLooseFolderClick" Margin="0,0,8,6" />
                    <Button Content="{helpers:Loc Library.Btn.Reconcile}" Click="OnReconcileClick" Margin="0,0,0,6" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Summary KPIs -->
        <UniformGrid x:Name="KpiStrip" Grid.Row="1" Columns="6" Margin="-3,0,-3,10">
            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="10">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Library.Kpi.Total}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="KpiTotal" Text="0" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="10">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Library.Kpi.Active}" FontSize="11" Foreground="{DynamicResource BrushGreen}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="KpiActive" Text="0" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="10">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Library.Kpi.Vault}" FontSize="11" Foreground="{DynamicResource BrushBlue}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="KpiVault" Text="0" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="10">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Library.Kpi.Overrides}" FontSize="11" Foreground="{DynamicResource BrushAmber}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="KpiOverrides" Text="0" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="10">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Library.Kpi.Loose}" FontSize="11" Foreground="{DynamicResource BrushAccentSoft}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="KpiLoose" Text="0" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="10">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc Library.Kpi.Size}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="KpiSize" Text="0 B" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Search & Filter Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Row="0" Grid.Column="0" MinWidth="180" TextChanged="OnSearchChanged" ToolTip="{helpers:Loc Library.SearchTooltip}" />
            <WrapPanel x:Name="FilterPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <RadioButton x:Name="FilterAll" Content="{helpers:Loc Common.All}" IsChecked="True" Checked="OnFilterChanged" Margin="0,2,10,2" />
                <RadioButton x:Name="FilterPaks" Content="{helpers:Loc Library.Filter.Paks}" Checked="OnFilterChanged" Margin="0,2,10,2" />
                <RadioButton x:Name="FilterOverrides" Content="{helpers:Loc Library.Filter.Overrides}" Checked="OnFilterChanged" Margin="0,2,10,2" />
                <RadioButton x:Name="FilterLoose" Content="{helpers:Loc Library.Filter.Loose}" Checked="OnFilterChanged" Margin="0,2,10,2" />
                <RadioButton x:Name="FilterActive" Content="{helpers:Loc Library.Filter.Active}" Checked="OnFilterChanged" Margin="0,2,10,2" />
                <RadioButton x:Name="FilterVault" Content="{helpers:Loc Library.Filter.InVault}" Checked="OnFilterChanged" Margin="0,2,0,2" />
            </WrapPanel>
        </Grid>

        <!-- Library Grid -->
        <DataGrid x:Name="LibraryGrid"
                  Grid.Row="3"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionChanged="OnGridSelectionChanged"
                  MouseDoubleClick="OnInspectClick">
            <DataGrid.Columns>
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Library.Col.ModName" Binding="{Binding DisplayName}" Width="1.7*" MinWidth="155" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Library.Col.Type" Binding="{Binding KindLabel}" Width="85" />
                <DataGridTemplateColumn helpers:LocHelper.HeaderKey="Library.Col.Location" Width="88">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding LocationBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding LocationLabel}" Foreground="{Binding LocationFg}" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn helpers:LocHelper.HeaderKey="Library.Col.Override" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding OverrideBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding OverrideTooltip}">
                                <TextBlock Text="{Binding OverrideLabel}" Foreground="{Binding OverrideFg}" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Library.Col.Files" Binding="{Binding FileSummary}" Width="1.4*" MinWidth="125" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Library.Col.Version" Binding="{Binding VersionText}" Width="78" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Library.Col.Size" Binding="{Binding SizeText}" Width="76" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Library.Col.Profiles" Binding="{Binding ProfilesSummary}" Width="1.2*" MinWidth="110" />
                <DataGridTextColumn helpers:LocHelper.HeaderKey="Library.Col.Id" Binding="{Binding ModId}" Width="105" />
                <DataGridTemplateColumn helpers:LocHelper.HeaderKey="Library.Col.Vault" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding VaultActionLabel}"
                                    Visibility="{Binding VaultActionVisibility}"
                                    Click="OnRowVaultActionClick"
                                    Padding="8,2"
                                    FontSize="11.5" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row Actions -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="DeleteModButton"
                    DockPanel.Dock="Right"
                    VerticalAlignment="Top"
                    Margin="8,0,0,6"
                    Content="{helpers:Loc Library.Btn.Uninstall}"
                    Style="{StaticResource DangerButton}"
                    Click="OnDeleteModClick" />
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="MoveToVaultButton" Content="{helpers:Loc Library.Btn.MoveToVault}" Click="OnMoveToVaultClick" Margin="0,0,8,6" />
                <Button x:Name="ActivateButton" Content="{helpers:Loc Library.Btn.Activate}" Style="{StaticResource AccentButton}" Click="OnActivateClick" Margin="0,0,12,6" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,6">
                    <TextBlock Text="{helpers:Loc Library.OverrideRuleLabel}" VerticalAlignment="Center" Style="{StaticResource MutedCaption}" Margin="0,0,6,0" />
                    <ComboBox x:Name="OverrideModeCombo" Width="155" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectionChanged="OnOverrideModeChanged" />
                </StackPanel>
                <Button x:Name="InspectButton" Content="{helpers:Loc Library.Btn.InspectFiles}" Click="OnInspectClick" Margin="0,0,0,6" />
            </WrapPanel>
        </DockPanel>
    </Grid>
</UserControl>
