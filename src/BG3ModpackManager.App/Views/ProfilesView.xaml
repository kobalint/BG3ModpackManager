<UserControl x:Class="BG3ModpackManager.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BG3ModpackManager.App.Helpers">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Profiles List -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{helpers:Loc Profiles.Title}" />
                    <TextBlock Style="{StaticResource MutedCaption}" Text="{helpers:Loc Profiles.Subtitle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <ListBox x:Name="ProfilesListBox"
                         Grid.Row="1"
                         SelectionChanged="OnProfileSelectionChanged"
                         HorizontalContentAlignment="Stretch"
                         Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,7" Margin="0,2" CornerRadius="4" Background="{DynamicResource BrushBgListItem}" BorderBrush="{Binding ItemBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right"
                                                Background="{DynamicResource BrushBadgeGreenBg}"
                                                CornerRadius="3"
                                                Padding="6,1"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{helpers:Loc Profiles.BadgeActive}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushGreen}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding SummaryLine}" Style="{StaticResource MutedCaption}" FontSize="11.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button Content="{helpers:Loc Profiles.Btn.CaptureActive}" Click="OnCaptureCurrentClick" Margin="0,0,4,0" ToolTip="{helpers:Loc Profiles.Btn.CaptureTooltip}" />
                        <Button Content="{helpers:Loc Profiles.Btn.NewEmpty}" Click="OnNewEmptyClick" Margin="4,0,0,0" />
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button Content="{helpers:Loc Profiles.Btn.ImportJson}" Click="OnImportJsonClick" Margin="0,0,4,0" ToolTip="{helpers:Loc Profiles.Btn.ImportJsonTooltip}" />
                        <Button Content="{helpers:Loc Profiles.Btn.ImportModpack}" Click="OnImportModpackClick" Margin="4,0,0,0" ToolTip="{helpers:Loc Profiles.Btn.ImportModpackTooltip}" />
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button x:Name="DuplicateButton" Content="{helpers:Loc Profiles.Btn.Duplicate}" Click="OnDuplicateClick" Margin="0,0,4,0" />
                        <Button x:Name="RenameButton" Content="{helpers:Loc Profiles.Btn.Rename}" Click="OnRenameClick" Margin="4,0,0,0" />
                    </UniformGrid>
                    <Button x:Name="DeleteButton" Content="{helpers:Loc Profiles.Btn.Delete}" Style="{StaticResource DangerButton}" Click="OnDeleteClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Column: Selected Profile Details -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Profile Header Card -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <DockPanel>
                    <Button x:Name="SwitchProfileButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource AccentButton}"
                            Content="{helpers:Loc Profiles.Btn.SwitchToThis}"
                            Padding="18,10"
                            FontSize="13.5"
                            VerticalAlignment="Center"
                            Click="OnSwitchToSelectedClick" />
                    <StackPanel Margin="0,0,16,0">
                        <DockPanel>
                            <Border x:Name="SelectedActivePill"
                                    DockPanel.Dock="Left"
                                    Background="{DynamicResource BrushBadgeGreenBg}"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <TextBlock Text="{helpers:Loc Profiles.CurrentlyActivePill}" Foreground="{DynamicResource BrushGreen}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock x:Name="SelectedProfileTitle" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <TextBlock x:Name="SelectedProfileSubtitle" Style="{StaticResource MutedCaption}" Margin="0,4,0,6" />
                        <WrapPanel>
                            <Button x:Name="LinkJsonButton" Content="{helpers:Loc Profiles.Btn.LinkJson}" Click="OnLinkJsonClick" Padding="10,4" Margin="0,0,6,0" />
                            <Button x:Name="SyncJsonButton" Content="{helpers:Loc Profiles.Btn.SyncJson}" Click="OnSyncJsonClick" Padding="10,4" Margin="0,0,6,0" />
                            <Button x:Name="ExportJsonButton" Content="{helpers:Loc Profiles.Btn.ExportJson}" Click="OnExportJsonClick" Padding="10,4" Margin="0,0,6,0" />
                            <Button x:Name="ExportArchiveButton"
                                    Content="{helpers:Loc Profiles.Btn.ExportArchive}"
                                    Click="OnExportArchiveClick"
                                    Padding="10,4"
                                    ToolTip="{helpers:Loc Profiles.Btn.ExportArchiveTooltip}" />
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Filter Bar -->
            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock x:Name="ProfileModsCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource MutedCaption}" Margin="12,0,0,0" />
                <TextBox x:Name="ProfileSearchBox" TextChanged="OnSearchChanged" ToolTip="{helpers:Loc Profiles.SearchTooltip}" />
            </DockPanel>

            <!-- Profile Mods Grid -->
            <DataGrid x:Name="ProfileModsGrid" Grid.Row="2" IsReadOnly="True" MouseDoubleClick="OnInspectModClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding OrderNumber}" Width="45" />
                    <DataGridTextColumn helpers:LocHelper.HeaderKey="Profiles.Col.ModName" Binding="{Binding DisplayName}" Width="2*" />
                    <DataGridTextColumn helpers:LocHelper.HeaderKey="Profiles.Col.Type" Binding="{Binding KindLabel}" Width="90" />
                    <DataGridTemplateColumn helpers:LocHelper.HeaderKey="Profiles.Col.Override" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding OverrideBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding OverrideTooltip}">
                                    <TextBlock Text="{Binding OverrideLabel}" Foreground="{Binding OverrideFg}" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn helpers:LocHelper.HeaderKey="Profiles.Col.Location" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding LocationBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding LocationLabel}" Foreground="{Binding LocationFg}" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn helpers:LocHelper.HeaderKey="Profiles.Col.Version" Binding="{Binding VersionText}" Width="85" />
                    <DataGridTextColumn helpers:LocHelper.HeaderKey="Profiles.Col.Size" Binding="{Binding SizeText}" Width="80" />
                    <DataGridTextColumn helpers:LocHelper.HeaderKey="Profiles.Col.Files" Binding="{Binding FileSummary}" Width="1.5*" />
                    <DataGridTemplateColumn helpers:LocHelper.HeaderKey="Profiles.Col.Vault" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding VaultActionLabel}"
                                        Visibility="{Binding VaultActionVisibility}"
                                        Click="OnRowVaultActionClick"
                                        Padding="8,2"
                                        FontSize="11.5" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Footer Actions -->
            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="AddModsButton" Content="{helpers:Loc Profiles.Btn.AddMods}" Style="{StaticResource AccentButton}" Click="OnAddModsClick" Margin="0,0,8,0" />
                    <Button x:Name="RemoveModButton" Content="{helpers:Loc Profiles.Btn.RemoveMod}" Click="OnRemoveModClick" Margin="0,0,8,0" />
                    <Button x:Name="MoveUpButton" Content="{helpers:Loc Profiles.Btn.MoveUp}" Click="OnMoveUpClick" Margin="0,0,6,0" />
                    <Button x:Name="MoveDownButton" Content="{helpers:Loc Profiles.Btn.MoveDown}" Click="OnMoveDownClick" />
                </StackPanel>
                <Button x:Name="InspectModButton" HorizontalAlignment="Right" Content="{helpers:Loc Profiles.Btn.InspectSelected}" Click="OnInspectModClick" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
