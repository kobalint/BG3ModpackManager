<Window x:Class="BG3ModpackManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:BG3ModpackManager.App.Helpers"
        Title="{helpers:Loc App.Title}"
        Style="{StaticResource AppWindowStyle}"
        Width="1280"
        Height="800"
        MinWidth="760"
        MinHeight="540"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen"
        SizeChanged="OnWindowSizeChanged"
        PreviewDragEnter="OnWindowDragEnter"
        PreviewDragOver="OnWindowDragOver"
        PreviewDragLeave="OnWindowDragLeave"
        PreviewDrop="OnWindowDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid x:Name="HeaderGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Branding, Active Profile Pill & BG3 Running Guard Pill -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True" Margin="0,0,12,0">
                    <Image Source="pack://application:,,,/Assets/app_icon.png"
                           Width="32"
                           Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{helpers:Loc App.Title}" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AppSubtitleText" Text="{helpers:Loc App.Subtitle}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Background="{DynamicResource BrushBadgeGreenBg}" BorderBrush="{DynamicResource BrushBadgeGreenBorder}" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock x:Name="ActiveProfilePillText"
                                   Foreground="{DynamicResource BrushGreen}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="260" />
                    </Border>
                    <Border x:Name="Bg3RunningPill"
                            Background="{DynamicResource BrushBadgeCrimsonBg}"
                            BorderBrush="{DynamicResource BrushBadgeCrimsonBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ToolTip="{helpers:Loc App.Bg3RunningTooltip}">
                        <TextBlock x:Name="Bg3RunningPillText" Foreground="{DynamicResource BrushCrimson}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- Right / Wrapped Row: Quick Profile Switcher, Refresh & Theme Toggle -->
                <StackPanel x:Name="HeaderControlsPanel"
                            Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border x:Name="DropHintBorder" Background="{DynamicResource BrushBgDropHint}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,12,0">
                        <TextBlock Text="{helpers:Loc App.DropHint}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" />
                    </Border>
                    <TextBlock x:Name="QuickSwitchLabel" Text="{helpers:Loc Nav.QuickSwitch}" VerticalAlignment="Center" Style="{StaticResource MutedCaption}" Margin="0,0,6,0" />
                    <ComboBox x:Name="QuickProfileCombo" Width="200" DisplayMemberPath="Name" Margin="0,0,6,0" />
                    <Button x:Name="QuickSwitchButton" Content="{helpers:Loc Nav.Switch}" Style="{StaticResource AccentButton}" Click="OnQuickSwitchClick" Margin="0,0,8,0" />
                    <Button x:Name="RefreshButton" Content="{helpers:Loc Nav.Refresh}" Click="OnRefreshClick" />
                    <Button x:Name="ThemeToggleButton" Click="OnThemeToggleClick" Margin="8,0,0,0" ToolTip="{helpers:Loc App.ThemeToggleTooltip}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: Navigation Rail / Top Nav + Main Content -->
        <Grid x:Name="BodyGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Container (Left Sidebar in Wide/Medium; Top Bar in Narrow) -->
            <Border x:Name="NavBorder"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="1"
                    Background="{DynamicResource BrushBgSidebar}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border x:Name="SidebarFooterBorder" DockPanel.Dock="Bottom" Padding="14,12" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="{helpers:Loc App.PortableMode}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentSoft}" />
                            <TextBlock x:Name="SidebarStatsText" Style="{StaticResource MutedCaption}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="NavItemsPanel" Orientation="Vertical" Margin="0,10,0,0">
                        <RadioButton x:Name="NavProfiles" Style="{StaticResource NavButton}" IsChecked="True" Checked="OnNavChecked">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="{DynamicResource BrushBgElevated}" CornerRadius="10" Padding="7,1" Margin="6,0,0,0">
                                    <TextBlock x:Name="NavProfilesCount" Text="0" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                </Border>
                                <TextBlock Text="{helpers:Loc Nav.Profiles}" VerticalAlignment="Center" />
                            </DockPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavReview" Style="{StaticResource NavButton}" Checked="OnNavChecked">
                            <DockPanel LastChildFill="True">
                                <Border x:Name="NavReviewAlertBadge" DockPanel.Dock="Right" Background="{DynamicResource BrushBadgeCrimsonBg}" CornerRadius="10" Padding="7,1" Margin="6,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="NavReviewAlertCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushCrimson}" />
                                </Border>
                                <TextBlock Text="{helpers:Loc Nav.Review}" VerticalAlignment="Center" />
                            </DockPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButton}" Checked="OnNavChecked">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="{DynamicResource BrushBgElevated}" CornerRadius="10" Padding="7,1" Margin="6,0,0,0">
                                    <TextBlock x:Name="NavLibraryCount" Text="0" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                </Border>
                                <TextBlock Text="{helpers:Loc Nav.Library}" VerticalAlignment="Center" />
                            </DockPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Checked="OnNavChecked">
                            <TextBlock Text="{helpers:Loc Nav.Settings}" VerticalAlignment="Center" />
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Active View Host -->
            <ContentControl x:Name="ViewHost" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="1" />
        </Grid>

        <!-- Collapsible Activity Log Drawer -->
        <Border x:Name="ActivityDrawer"
                Grid.Row="2"
                Height="160"
                Background="{DynamicResource BrushBgDrawer}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <DockPanel Margin="12,8">
                <TextBlock DockPanel.Dock="Top" Text="{helpers:Loc Nav.ActivityLog}" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentSoft}" Margin="0,0,0,6" />
                <ListBox x:Name="ActivityLogList" FontFamily="Consolas" FontSize="11.5" BorderThickness="0" Background="Transparent" />
            </DockPanel>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{helpers:Loc Nav.ActivityLog}" Padding="10,3" FontSize="11.5" Click="OnToggleActivityLogClick" />
                <TextBlock x:Name="StatusBarStatsText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource MutedCaption}" Margin="0,0,12,0" Visibility="Collapsed" />
                <TextBlock x:Name="StatusBarText" VerticalAlignment="Center" Style="{StaticResource MutedCaption}" TextTrimming="CharacterEllipsis" Text="{helpers:Loc App.Ready}" />
            </DockPanel>
        </Border>

        <!-- Drag & Drop Overlay -->
        <Border x:Name="DropOverlay"
                Grid.RowSpan="4"
                Background="{DynamicResource BrushBgOverlay}"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border BorderBrush="{DynamicResource BrushAccent}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Background="{DynamicResource BrushBgCard}"
                    Margin="24"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{helpers:Loc App.DropOverlayTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushAccentSoft}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{helpers:Loc App.DropOverlaySubtitle}"
                               Style="{StaticResource MutedCaption}"
                               FontSize="13"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Async Busy Overlay -->
        <Border x:Name="BusyOverlay"
                Grid.RowSpan="4"
                Background="{DynamicResource BrushBgBusyOverlay}"
                Visibility="Collapsed">
            <Border Style="{StaticResource CardBorder}"
                    BorderBrush="{DynamicResource BrushAccent}"
                    MinWidth="300"
                    MaxWidth="440"
                    Margin="24"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc App.Working}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentSoft}" Margin="0,0,0,8" />
                    <TextBlock x:Name="BusyMessageText" Text="{helpers:Loc App.PleaseWait}" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <ProgressBar Height="6" IsIndeterminate="True" Foreground="{DynamicResource BrushAccentSoft}" Background="{DynamicResource BrushBgElevated}" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
